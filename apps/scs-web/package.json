{
  "name": "@scs/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Todo SCS microfrontend: React app compiled into a self-contained <scs-todo-app> web component",
  "scripts": {
    "dev": "concurrently -k \"vite build --watch\" \"node scripts/serve.mjs\"",
    "build": "npm run typecheck && vite build",
    "typecheck": "tsc --noEmit",
    "serve": "node scripts/serve.mjs"
  },
  "dependencies": {
    "@scs/shared": "*",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.5",
    "vite": "^8.3.3"
  }
}
