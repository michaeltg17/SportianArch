{
  "name": "sportian-arch",
  "private": true,
  "version": "0.1.0",
  "packageManager": "npm@11.13.0",
  "description": "Self-Contained Systems (SCS) demo: embeddable Todo vertical with .NET minimal APIs, RabbitMQ, Postgres and a React web component",
  "workspaces": [
